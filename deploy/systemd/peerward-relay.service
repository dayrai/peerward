[Unit]
Description=Peerward relay service
Documentation=https://github.com/dayrai/peerward/blob/main/docs/deployment.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=peerward
Group=peerward
EnvironmentFile=-/etc/peerward/relay.env
ExecStartPre=/usr/bin/peerward config check --role relay /etc/peerward/relay.toml
ExecStart=/usr/bin/peerward relay run --config /etc/peerward/relay.toml
Restart=on-failure
RestartSec=3s
TimeoutStopSec=30s
RuntimeDirectory=peerward
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=peerward
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# Optional host-configured QUIC/WSS listeners may use UDP/TCP 443.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/peerward /run/peerward

[Install]
WantedBy=multi-user.target
