[Unit]
Description=Peerward control service
Documentation=https://github.com/dayrai/peerward/blob/main/docs/deployment.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=peerward
Group=peerward
EnvironmentFile=-/etc/peerward/control.env
Environment=PEERWARD_DYNAMIC_CONFIG=/etc/peerward/dynamic.toml
ExecStartPre=/usr/bin/peerward config check --role control /etc/peerward/control.toml
ExecStart=/usr/bin/peerward control run --config /etc/peerward/control.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
RuntimeDirectory=peerward
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=peerward
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/peerward /run/peerward

[Install]
WantedBy=multi-user.target
