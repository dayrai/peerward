[Unit]
Description=Peerward Linux peer
Documentation=https://github.com/dayrai/peerward/blob/main/docs/deployment.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peerward
Group=peerward
EnvironmentFile=-/etc/peerward/peer.env
# peer run recovers interrupted identity rotation before validating credentials.
# A separate config check here would reject partially committed identity files.
ExecStart=/usr/bin/peerward peer run --config /etc/peerward/peer.toml
ExecStopPost=/usr/bin/peerward doctor --config /etc/peerward/peer.toml --json
Restart=on-failure
RestartSec=3s
TimeoutStopSec=45s
RuntimeDirectory=peerward
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
StateDirectory=peerward
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
DeviceAllow=/dev/net/tun rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/peerward /run/peerward

[Install]
WantedBy=multi-user.target
