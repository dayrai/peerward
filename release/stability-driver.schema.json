{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://peerward.dev/schemas/stability-driver-v1.json",
  "title": "Peerward external Linux stability lab driver result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "scope", "tier", "evidence_binding", "started_at", "finished_at", "environment", "tool_versions", "relay_identities", "traffic", "scenarios", "metrics", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "enum": ["capacity", "soak"] },
    "scope": { "const": "end_to_end" },
    "tier": { "enum": [100, 1000, 10000] },
    "evidence_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit_sha", "artifact_set_sha256"],
      "properties": {
        "commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_set_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware", "kernel", "peerward_version", "postgresql_version"],
      "properties": {
        "hardware": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 },
        "peerward_version": { "type": "string", "minLength": 1 },
        "postgresql_version": { "type": "string", "minLength": 1 }
      }
    },
    "tool_versions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string", "minLength": 1 } },
    "relay_identities": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "traffic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_seconds", "model", "concurrent_rate", "relay_packet_ratio"],
      "properties": {
        "duration_seconds": { "type": "integer", "minimum": 1 },
        "model": { "type": "string", "minLength": 1 },
        "concurrent_rate": { "type": "number", "minimum": 0 },
        "relay_packet_ratio": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connection_establishment", "steady_forwarding", "reconnect_storm", "relay_failure", "postgresql_failure_recovery", "resource_bounds", "no_plaintext"],
      "properties": {
        "connection_establishment": { "const": "passed" },
        "steady_forwarding": { "const": "passed" },
        "reconnect_storm": { "const": "passed" },
        "relay_failure": { "const": "passed" },
        "postgresql_failure_recovery": { "const": "passed" },
        "resource_bounds": { "const": "passed" },
        "no_plaintext": { "const": "passed" }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency_ms", "throughput_packets_per_second", "failed_operations", "cpu_percent", "ram_bytes", "relay_ingress_bytes_per_second", "relay_egress_bytes_per_second", "postgresql_tps", "postgresql_wal_bytes", "recovery_seconds"],
      "properties": {
        "latency_ms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p50", "p95", "p99"],
          "properties": {
            "p50": { "type": "number", "minimum": 0 },
            "p95": { "type": "number", "minimum": 0 },
            "p99": { "type": "number", "minimum": 0 }
          }
        },
        "throughput_packets_per_second": { "type": "number", "minimum": 0 },
        "failed_operations": { "type": "number", "minimum": 0 },
        "cpu_percent": { "type": "number", "minimum": 0 },
        "ram_bytes": { "type": "number", "minimum": 0 },
        "relay_ingress_bytes_per_second": { "type": "number", "minimum": 0 },
        "relay_egress_bytes_per_second": { "type": "number", "minimum": 0 },
        "postgresql_tps": { "type": "number", "minimum": 0 },
        "postgresql_wal_bytes": { "type": "number", "minimum": 0 },
        "recovery_seconds": { "type": "number", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
